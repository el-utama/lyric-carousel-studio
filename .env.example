# OpenAI-compatible language model. The key stays on the Express server.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: Google Gemini (alternative to OpenAI-compatible LLM).
# Isi GEMINI_API_KEY jika ingin menggunakan Gemini langsung tanpa proxy OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional vision model for reference-image reading in Phase 4.
# Leave blank to analyse colour and lighting on the client only.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

PORT=8787
